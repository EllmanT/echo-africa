# Canonical site URL — used for metadataBase, sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.eka.dev

# Google Search Console — from the HTML tag verification method (the "content" value only).
# https://search.google.com/search-console -> Add property -> URL prefix -> HTML tag
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — Measurement ID from your GA4 property (starts with "G-").
# https://analytics.google.com -> Admin -> Data Streams -> your web stream
NEXT_PUBLIC_GA_ID=
