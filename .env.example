# Canonical site URL, used for metadataBase, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.eka.dev

# Google Search Console HTML tag verification (content value only).
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (starts with G-).
NEXT_PUBLIC_GA_ID=

# MongoDB Atlas. Use a dedicated database user and the database name below.
MONGODB_URI=
MONGODB_DB=eka

# SMTP (Gmail app password works). Used for lead confirmation and owner notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=
# Address that receives new-lead notifications.
LEAD_NOTIFY_EMAIL=tmuranda1@gmail.com

# Anthropic API key for the Playbook article generator.
ANTHROPIC_API_KEY=

# Vercel Blob read/write token (admin image uploads).
BLOB_READ_WRITE_TOKEN=

# Admin login. ADMIN_PASSWORD_HASH_B64 is a bcrypt hash, base64-encoded (see
# lib/admin/auth.ts for why: Next's env loader corrupts a raw "$2a$10$..."
# value). SESSION_SECRET is a long random string.
ADMIN_PASSWORD_HASH_B64=
SESSION_SECRET=

# Shared secret for scheduled jobs (GitHub Actions calls /api/cron/* with this).
CRON_SECRET=
